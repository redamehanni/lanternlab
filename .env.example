# Ma Zone — Variables d'environnement
# Copier en .env.local et renseigner avec les valeurs du projet Supabase.
# Sans ces variables, l'application tourne en mode démonstration (données Paris en mémoire).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service (serveur uniquement, ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (utilisée pour les métadonnées Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000
